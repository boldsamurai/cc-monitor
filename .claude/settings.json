{
  "enabledPlugins": {
    "hangar-core@hangar": true
  },
  "extraKnownMarketplaces": {
    "hangar": {
      "autoUpdate": true,
      "source": {
        "ref": "stable",
        "repo": "boldsamurai/hangar",
        "source": "github"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(git branch --show-current)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(glab mr merge:*)",
      "Bash(hangar check:*)",
      "Bash(hangar ci-policy:*)",
      "Bash(hangar claim:*)",
      "Bash(hangar doctor:*)",
      "Bash(hangar forge:*)",
      "Bash(hangar heartbeat:*)",
      "Bash(hangar lanes check:*)",
      "Bash(hangar lanes list:*)",
      "Bash(hangar lanes peers:*)",
      "Bash(hangar lanes sync:*)",
      "Bash(hangar lanes wait:*)",
      "Bash(hangar lesson suggest:*)",
      "Bash(hangar limits:*)",
      "Bash(hangar ready:*)",
      "Bash(hangar release:*)",
      "Bash(hangar render --dry-run:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)"
    ],
    "ask": [
      "Bash(chgrp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)"
    ],
    "deny": [
      "Bash(doas:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.docker)",
      "Edit(**/.env.local)",
      "Edit(**/.env.prd)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.production)",
      "Edit(**/.env.qa)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.uat)",
      "Edit(**/.netrc)",
      "Edit(**/credentials.json)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/id_rsa*)",
      "Edit(~/.aws/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.ci)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.docker)",
      "Read(**/.env.local)",
      "Read(**/.env.prd)",
      "Read(**/.env.preview)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.qa)",
      "Read(**/.env.stage)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.uat)",
      "Read(**/.netrc)",
      "Read(**/credentials.json)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)",
      "Edit(**/*.ovpn)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/glab-cli/**)",
      "Edit(~/.git-credentials)",
      "Read(**/*.ovpn)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab-cli/**)",
      "Read(~/.git-credentials)"
    ]
  }
}
