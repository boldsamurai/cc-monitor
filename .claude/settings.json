{
  "enabledPlugins": {
    "hangar-core@hangar": true
  },
  "extraKnownMarketplaces": {
    "hangar": {
      "autoUpdate": true,
      "source": {
        "ref": "stable",
        "repo": "boldsamurai/hangar",
        "source": "github"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(git branch --show-current)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(glab mr merge:*)",
      "Bash(hangar check:*)",
      "Bash(hangar ci-policy:*)",
      "Bash(hangar claim:*)",
      "Bash(hangar doctor:*)",
      "Bash(hangar forge:*)",
      "Bash(hangar heartbeat:*)",
      "Bash(hangar lanes check:*)",
      "Bash(hangar lanes list:*)",
      "Bash(hangar lanes peers:*)",
      "Bash(hangar lanes sync:*)",
      "Bash(hangar lanes wait:*)",
      "Bash(hangar lesson suggest:*)",
      "Bash(hangar limits:*)",
      "Bash(hangar ready:*)",
      "Bash(hangar release:*)",
      "Bash(hangar render --dry-run:*)",
      "Bash(poetry run pytest:*)",
      "Bash(poetry run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)"
    ],
    "ask": [
      "Bash(chgrp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(rm -f:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Bash(doas:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(git branch -D develop:*)",
      "Bash(git branch -D main:*)",
      "Bash(git branch -D master:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git update-ref -d:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.docker)",
      "Edit(**/.env.local)",
      "Edit(**/.env.prd)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.production)",
      "Edit(**/.env.qa)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.uat)",
      "Edit(**/.netrc)",
      "Edit(**/credentials.json)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/id_rsa*)",
      "Edit(~/.aws/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.ssh/**)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.env.*.local)",
      "Read(**/.env.ci)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.docker)",
      "Read(**/.env.local)",
      "Read(**/.env.prd)",
      "Read(**/.env.preview)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.qa)",
      "Read(**/.env.stage)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.uat)",
      "Read(**/.netrc)",
      "Read(**/credentials.json)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
